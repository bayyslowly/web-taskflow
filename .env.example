# ============================================================================
# TaskFlow Environment Variables
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi MariaDB Anda.
# ============================================================================

# Port Server Backend Express
PORT=5000

# Konfigurasi Koneksi MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskflow_db
